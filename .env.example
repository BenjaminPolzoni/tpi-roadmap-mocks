# Ruta al clon local de tpi-roadmap (por defecto ../tpi-roadmap)
# ROADMAP_PATH=../tpi-roadmap

# Perfiles de Spring Boot para Roadmap (por defecto dev,demo)
# ROADMAP_PROFILES=dev,demo

# Habilitar simulacion en Roadmap (por defecto true)
# SIMULATION_ENABLED=true

# Republicacion de matriculas sembradas al iniciar courses (por defecto false).
# Debe ir en true UNICAMENTE si ROADMAP_PROFILES NO incluye el perfil 'demo',
# ya que con 'demo' Roadmap auto-siembra los 12 alumnos y republicar genera
# colision de clave unica en student_course. Cambiar de perfil requiere 'docker compose down -v'.
# PUBLISH_SEED_ENROLLMENTS=false
